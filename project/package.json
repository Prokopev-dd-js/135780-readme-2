{
  "name": "@project/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "eslint apps libs tools --max-warnings 0",
    "db:fill": "nx run @project/publication:db-fill",
    "typecheck": "nx run-many -t typecheck -p @project/account @project/publication @project/file @project/notification @project/gateway && tsc --project tools/tsconfig.json && tsc --project apps/publication/prisma/tsconfig.json",
    "build": "nx run-many -t build -p @project/account @project/publication @project/file @project/notification @project/gateway",
    "start": "nx run-many -t start -p @project/account @project/publication @project/file @project/notification @project/gateway --parallel=5",
    "test": "nx build shared-api && tsx --tsconfig tsconfig.base.json tools/test.ts",
    "test:e2e": "tsx --tsconfig tsconfig.base.json tools/verify-api.ts",
    "test:e2e:all": "tsx --tsconfig tsconfig.base.json tools/verify-api.ts --optional",
    "infra:up": "docker compose --env-file apps/account/.env -f apps/account/docker-compose.dev.yml up -d && docker compose --env-file apps/publication/.env -f apps/publication/docker-compose.dev.yml up -d && docker compose --env-file apps/notification/.env -f apps/notification/docker-compose.dev.yml up -d",
    "stage:build": "docker compose --env-file .env.stage -f docker-compose.stage.yml build",
    "stage:up": "docker compose --env-file .env.stage -f docker-compose.stage.yml up -d --wait",
    "stage:down": "docker compose --env-file .env.stage -f docker-compose.stage.yml down"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.2.9",
    "mongoose": "^9.10.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.13",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/js": "23.1.3",
    "@nx/nest": "23.1.3",
    "@nx/node": "23.1.3",
    "@nx/web": "23.1.3",
    "@nx/webpack": "23.1.3",
    "@nx/workspace": "23.1.3",
    "@swc/helpers": "~0.5.18",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "nx": "23.1.3",
    "prisma": "^6.19.3",
    "tslib": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}
