GATEWAY_PORT=4000
MAILPIT_UI_PORT=8026
ACCOUNT_MONGO_DB=readme-account
ACCOUNT_MONGO_USER=readme
ACCOUNT_MONGO_PASSWORD=replace-with-url-safe-stage-password
NOTIFICATION_MONGO_DB=readme-notification
NOTIFICATION_MONGO_USER=readme
NOTIFICATION_MONGO_PASSWORD=replace-with-url-safe-stage-password
POSTGRES_DB=readme-publication
