{
  "name": "@project/shared-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "shared-types",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsc --project libs/shared-types/tsconfig.lib.json --emitDeclarationOnly false --tsBuildInfoFile libs/shared-types/dist/tsconfig.build.tsbuildinfo"
        }
      }
    }
  },
  "dependencies": {}
}
